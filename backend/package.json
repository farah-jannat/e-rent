{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run dist/migrate.js && bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "build": "bun run build:app && bun run build:migrate",
    "build:app": "bun build src/index.ts --outdir ./dist --target bun --minify",
    "build:migrate": "bun build drizzle/migrate.ts --outdir ./dist --target bun --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fvoid/shared-lib": "^1.0.45",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.17.2"
  }
}
